{
  "name": "green-link-smartfarm",
  "private": true,
  "version": "1.0.0-rc.2",
  "engines": {
    "node": ">=22.5"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"node --watch server/index.js\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "start": "node server/index.js",
    "start:lan": "node scripts/start-lan.js",
    "start:public": "node scripts/start-public.js",
    "build": "npm run contracts:compile && tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src server scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "npm run contracts:compile && vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:init": "node -e \"import('./server/store.js').then(({createStore})=>createStore().close())\"",
    "db:backup": "node server/backup.js",
    "iot:simulator": "node server/iot-simulator.js",
    "contracts:compile": "node scripts/compile-contracts.js",
    "contracts:deploy": "node scripts/deploy-contracts.js"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "hls.js": "1.6.13",
    "leaflet": "1.9.4",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-leaflet": "5.0.0",
    "viem": "2.55.19"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/leaflet": "1.9.20",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "^10.0.5",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "prettier": "3.6.2",
    "solc": "0.8.30",
    "supertest": "^7.2.2",
    "typescript": "latest",
    "typescript-eslint": "8.41.0",
    "vite": "8.2.0",
    "vitest": "^4.1.10"
  }
}
