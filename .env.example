# Application
PORT=4100
HOST=0.0.0.0
NODE_ENV=development
TRUST_PROXY=false
SESSION_HOURS=12

# Local PostgreSQL example. Docker Compose supplies its own DATABASE_URL.
DATABASE_URL=postgres://smartfarm:change-me@localhost:5432/smartfarm
POSTGRES_PASSWORD=change-me

# Authentication
LOGIN_ACCOUNT_SOURCE=database
# LOGIN_ACCOUNTS_FILE=/absolute/path/to/local/accounts.txt

# Use a unique random value of at least 32 characters in production.
LEDGER_SIGNING_KEY=replace-with-a-unique-random-secret

# Demo payment provider; no real money is charged.
PAYMENT_PROVIDER=mock

# Optional Hyperledger Fabric transaction anchoring
ENABLE_CHAIN_ANCHOR=false
CHAIN_ANCHOR_INTERVAL_MS=30000
FABRIC_PEER_ENDPOINT=peer0.org1.smartfarm.com:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.smartfarm.com
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL=txchannel
FABRIC_CHAINCODE=txanchor
FABRIC_MSP_DIR=/fabric-org/users/Admin@org1.smartfarm.com/msp
FABRIC_PEER_TLS_CERT=/fabric-org/peers/peer0.org1.smartfarm.com/tls/ca.crt

# Optional IoT simulator
# IOT_API_URL=http://localhost:4100
# IOT_DEVICE_KEY=issued-device-key
