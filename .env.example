PORT=4100
HOST=0.0.0.0
NODE_ENV=development
TRUST_PROXY=false
SESSION_HOURS=12
# Absolute path is recommended for deployment. Defaults to server/data/smartfarm.sqlite.
# SMARTFARM_DB=C:\data\smartfarm.sqlite
# Database authentication is the default. TXT is retained only for local legacy testing.
LOGIN_ACCOUNT_SOURCE=database
# LOGIN_ACCOUNTS_FILE=C:\data\login-accounts.txt
# Required outside local development. Generate with a password manager (at least 32 random bytes).
BLOCKCHAIN_SIGNING_KEY=replace-with-a-long-random-secret
# PaymentProvider defaults to mock credits. No real money is charged in this demo.
PAYMENT_PROVIDER=mock

# Optional EVM public-chain layer. Keep the private key server-side and out of git.
# PUBLIC_CHAIN_RPC_URL=https://your-evm-rpc.example
# PUBLIC_CHAIN_ID=11155111
# PUBLIC_CHAIN_NAME=Sepolia
# PUBLIC_CHAIN_CURRENCY=ETH
# PUBLIC_CHAIN_ASSET_ADDRESS=0x0000000000000000000000000000000000000000
# PUBLIC_CHAIN_MARKETPLACE_ADDRESS=0x0000000000000000000000000000000000000000
# PUBLIC_CHAIN_RELAYER_PRIVATE_KEY=0x64_hex_characters
# PUBLIC_CHAIN_CONFIRMATIONS=2
# PUBLIC_CHAIN_EXPLORER_URL=https://sepolia.etherscan.io
# PUBLIC_CHAIN_METADATA_URI=https://your-domain.example/token/{id}.json
# PUBLIC_CHAIN_FEE_BPS=0
